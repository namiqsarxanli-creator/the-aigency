# MƏTN provayderləri sırayla sınanır: Groq -> Gemini -> Cerebras -> OpenRouter -> Hugging Face.
# Yalnız GROQ_API_KEY kifayətdir (pulsuz), amma onun tarif planı tez dolduğu üçün
# Gemini/HF açarlarını da qoysanız, Groq rate-limit versə sistem avtomatik növbətiyə keçir.
# OPENAI bu zəncirdə YOXDUR — o açar ödənişlidir və YALNIZ şəkil generasiyası üçün
# saxlanılır (aşağıda, "ŞƏKİL" bölməsində).

# Groq (pulsuz) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (pulsuz tarif var) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Inference Providers (pulsuz tarif var) — https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Defolt SQLite kifayətdir, ayrıca DB qurmağa ehtiyac yoxdur
DATABASE_URL=sqlite:///./agency.db
# İstehsal: postgresql+psycopg://agency:CHANGE_ME@postgres:5432/agency
REDIS_URL=redis://127.0.0.1:6379/0
WORKER_MODE=embedded
APP_ENV=development
COOKIE_SECURE=auto
EXTERNAL_ACTIONS_ENABLED=false
# Bunlar bir-birindən tam ayrıdır. Instagram üçün yalnız birincini açın.
SOCIAL_PUBLISH_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# TÖVSİYƏ OLUNUR — DOLDURUN. Boş qalsa /agency/pending-approval, /agency/{id}/image və
# /mark-notified marşrutları TAMAMİLƏ AUTENTİFİKASİYASIZ olur və BÜTÜN workspace-lərin
# gözləyən layihələrini (brif mətni, Telegram chat ID, şəkil linki) qaytarır — yəni çox-kirayəçi
# izolyasiyası bu üç marşrutda işləmir. Dolarsa /agency/brief, /run, /approve, /reject,
# /mark-notified, /pending-approval, /{id}/image üçün `X-API-Key` başlığı tələb olunur.
# Açar yaratmaq:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# AYARLASANIZ: n8n-dəki bütün "Yeni layihə yarat"/"Təsdiqlə"/"Rədd et"/"Bildirildi kimi işarələ"/
# "Təsdiq gözləyənləri gətir"/"Şəkli yüklə" node-larına "Send Headers" ilə eyni açarı
# X-API-Key kimi əlavə etməlisiniz, əks halda onlar 401 alacaq.
# QEYD: Instagram/Meta şəkli özü yüklədiyi və başlıq göndərə bilmədiyi üçün şəklin İCTİMAİ
# ünvanı ayrıca mövcuddur: /s/{share_token}/image (ardıcıl ID yox, təxminedilməz token).
AGENCY_API_KEY=

# İxtiyari — web dashboard-dan yaradılan briflərin Telegram chat_id-si olmur, ona görə defolt
# olaraq onlara bildiriş getmir. Öz chat ID-nizi bura yazsanız (@userinfobot-dan öyrənilir),
# web-dən yaratdığınız layihələr də hazır olanda Telegram-a bildirilir.
DEFAULT_TELEGRAM_CHAT_ID=

# Müştəriyə göndərilən "nəticəyə bax" linkinin əvvəlinə əlavə olunur (Telegram bildirişində
# göndərilir). LOKAL testdə defolt kifayətdir, amma MÜŞTƏRİ linki xaricdən açsın deyə bu, backend-in
# özünün İCTİMAİ ünvanı olmalıdır (ngrok və s. ilə port 8800-ü ayrıca tunelləməlisiniz — n8n üçün
# istifadə etdiyiniz tunel yalnız port 5678-i açır, bu KAFİ DEYİL).
# DİQQƏT: Instagram paylaşımı üçün DƏ vacibdir — Meta şəkli bu URL-dən özü yükləyir, lokal olsa işləməz.
PUBLIC_BASE_URL=http://127.0.0.1:8800

# YALNIZ Instagram media ünvanı üçün (şəkli Meta ÖZÜ yükləyir, ona görə ictimai olmalıdır).
# Niyə ayrı sahə: PUBLIC_BASE_URL-i https etsəniz, sessiya çərəzi `Secure` işarələnir və
# tətbiqə http://127.0.0.1:8800 ilə girmək mümkün olmur. Bu sahə ikisini uzlaşdırır.
# Pulsuz tunel: cloudflared tunnel --url http://localhost:8800
# (URL hər başladıqda dəyişir — yeniləməyi unutmayın)
PUBLIC_MEDIA_BASE_URL=

# --- Instagram avtomatik paylaşım (rəsmi Graph API) ---
# Şərtlər: (1) IG hesabı Business və ya Creator olmalıdır; adi şəxsi hesab paylaşa BİLMİR.
# (2) developers.facebook.com-da app yaradın: Use cases -> "Manage messaging & content on
# Instagram" -> API setup with Instagram login. (3) Permissions bölməsində
# instagram_business_basic + instagram_business_content_publish əlavə edin. (4) Həmin
# səhifədə "Generate access tokens" ilə token alın (60 gün etibarlıdır, YALNIZ BİR DƏFƏ
# göstərilir). (5) PUBLIC_BASE_URL ictimai olmalıdır (yuxarı).
# Boş qalsa "Instagram-da paylaş" düyməsi işləməz (deaktiv).
INSTAGRAM_ACCESS_TOKEN=
# IG hesab ID-si (ədəd) — token alma səhifəsində hesabın adının altında yazılır
INSTAGRAM_USER_ID=
# API versiyası (defolt kifayətdir, Meta versiyaları köhnələndə yeniləyin)
INSTAGRAM_API_VERSION=v23.0
# Giriş axını. Defolt "Instagram login" — Facebook Page TƏLƏB ETMİR.
# Page üzərindən qurulmuş app üçün: https://graph.facebook.com
# DİQQƏT: iki axının tokenləri bir-birini ƏVƏZ ETMİR.
INSTAGRAM_API_HOST=https://graph.instagram.com

# --- TikTok avtomatik paylaşım (rəsmi Content Posting API) ---
# (1) developers.tiktok.com-da app yaradın, "Content Posting API" məhsulunu əlavə edin,
# "user.info.basic" + "video.publish" scope-larını aktivləşdirin. (2) Aşağıdakı üç dəyəri
# app-ın "Manage apps" səhifəsindən götürün. (3) TIKTOK_REDIRECT_URI-ni tam olaraq TikTok
# app konfiqurasiyasında yazdığınız "Redirect URI" ilə EYNİ yazın (məs.
# https://sizin-domen/tiktok/callback) — PUBLIC_BASE_URL HTTPS olmalıdır.
# Hər workspace öz hesabını Brand Kit səhifəsindən "TikTok qoş" düyməsi ilə qoşur (OAuth) —
# burada statik istifadəçi tokeni YOXDUR. App audit keçməyibsə paylaşım YALNIZ hesab
# sahibinin özünə (SELF_ONLY) görünən olur; açıq paylaşım üçün TikTok-a audit lazımdır.
# Boş qalsa "TikTok qoş" düyməsi işləməz (deaktiv).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Vizual mənbə sırası: Pexels -> Unsplash -> Pixabay -> AI generasiyası -> (son çarə) Commons.
# Üçü də PULSUZDUR və kart tələb etmir; açarı boş qalan provayder sadəcə keçilir.
# https://www.pexels.com/api/          200 sorğu/saat, 20 000/ay — ən səxavətli
PEXELS_API_KEY=
# https://unsplash.com/oauth/applications   "Access Key"; demo rejimi 50 sorğu/saat, ən yüksək keyfiyyət
UNSPLASH_ACCESS_KEY=
# https://pixabay.com/api/docs/        ən geniş çeşid (foto, illüstrasiya, vektor)
PIXABAY_API_KEY=
# Heç bir stok açarı yoxdursa bunu "true" saxlayın — əks halda vizual ya boş qalır, ya da Commons
# arxivindən mövzuya uyğun olmayan (və brauzerdən 429 verib açılmayan) nəticələr gəlir.
ALLOW_AI_IMAGE_FALLBACK=true

# Əlavə LLM provayderi (EHTİYAT) — https://openrouter.ai/keys
# Pulsuz, kart tələb etmir. ~20 sorğu/dəq, gündə 50 sorğu ($10 kredit alsanız 1000/gün).
# DİQQƏT: model adı mütləq ":free" ilə bitməlidir, əks halda ödənişli tarifə düşür.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Cerebras — cox suretli (custom LPU), yaxsi keyfiyyet (Llama 3.3 70B).
# DIQQET: iyul 2026-dan kart teleb edir (bir defelik $5 trial krediti, 30 gunde bitir)
# -- evvelki tam pulsuz tarif legv edilib. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# --- Sayt elaqe melumatlari (footer-de gosterilir) ---
# Bos qalsa saytda HEC NE gosterilmir. Beynelxalq formatda yazin.
CONTACT_PHONE=
CONTACT_EMAIL=
# Mes: B.e-Cume, 09:00-18:00
CONTACT_HOURS=

# --- ŞƏKİL generasiyası (OpenAI, gpt-image-1) — ÖDƏNİŞLİDİR ---
# https://platform.openai.com/api-keys · Studio+ materiallarının şəkli birinci bununla
# yaradılır (uğursuz olsa stok foto -> Pollinations-a keçir). Mətn sorğularında İSTİFADƏ
# OLUNMUR — bax yuxarı.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Veo video (ÖDƏNİŞLİDİR, pulsuz tarifi yoxdur). Açmadan heç bir sorğu getmir.
VEO_ENABLED=false
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_DAILY_LIMIT=10
VEO_COST_PER_VIDEO=0.40

# Lokal n8n-in daxili unvani. Doldurulsa, `/webhook*` istekleri n8n-e otururulur ki, pulsuz
# ngrok-un tek statik domeni hem Twilio, hem de n8n Telegram webhook-una xidmet etsin.
# Bulud serverinde n8n olmadigi ucun BOS saxlayin.
N8N_INTERNAL_URL=
